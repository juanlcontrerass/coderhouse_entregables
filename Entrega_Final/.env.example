# Copie este archivo como .env y complete la clave. El .env nunca se sube al repositorio.

# --- LLM (obligatorio) ---
OPENAI_API_KEY=tu_api_key_de_openai
OPENAI_MODEL=gpt-5.4-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# --- RAG híbrido (obligatorio: colección y modelo de embeddings) ---
CHROMA_COLLECTION=techcorp_docs
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
TOP_K=4
RETRIEVAL_CANDIDATES=8
HYBRID_BM25_WEIGHT=0.5
HYBRID_DENSE_WEIGHT=0.5
RRF_K=60
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=100

# --- Orquestador ---
# MAX_STEPS=8
# MAX_REVISIONS=2
# MAX_VALIDATION_RETRIES=1
HISTORY_TURNS=3

# --- Redis (jobs, cola de Arq y checkpoints de LangGraph) ---
# En Docker Compose se reemplaza por redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
JOB_TIMEOUT_SECONDS=300
WORKER_MAX_JOBS=10
# JOB_TTL_SECONDS=604800
# CONVERSATION_TTL_MINUTES=10080

# --- Human-in-the-loop ---
COST_APPROVAL_TOKEN_THRESHOLD=60000

# --- Observabilidad (Arize Phoenix) ---
# En Docker Compose se reemplaza por http://phoenix:6006/v1/traces
PHOENIX_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=intelligence-system
# Solo si Phoenix tiene la autenticación activada (PHOENIX_ENABLE_AUTH=true)
# PHOENIX_API_KEY=
