# Copia este archivo como .env y completa tu clave. No subas el .env al repositorio.

# --- LLM ---
OPENAI_API_KEY=tu_api_key_de_openai
# OPENAI_MODEL=gpt-5.4-mini
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Redis (estado de los jobs, cola de Arq y checkpoints de LangGraph) ---
REDIS_URL=redis://localhost:6379/0
# JOB_TTL_SECONDS=604800
JOB_TIMEOUT_SECONDS=300
WORKER_MAX_JOBS=10

# --- Human-in-the-loop ---
# Tokens por ejecución a partir de los cuales se pide aprobación humana
COST_APPROVAL_TOKEN_THRESHOLD=60000

# --- Observabilidad (Arize Phoenix) ---
PHOENIX_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=orquestador-multiagente
# Solo si Phoenix tiene la autenticación activada (PHOENIX_ENABLE_AUTH=true)
# PHOENIX_API_KEY=
